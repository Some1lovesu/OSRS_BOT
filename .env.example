# ── Required ──────────────────────────────────────────────────────────────────
# Discord bot token
DISCORD_TOKEN=your_discord_bot_token_here

# ── Wise Old Man ───────────────────────────────────────────────────────────────
# Optional API key — raises rate limit from 20 → 100 req/min
WOM_API_KEY=

# ── Daily Roundup ─────────────────────────────────────────────────────────────
# Channel ID where the daily XP/boss roundup is posted
ROUNDUP_CHANNEL_ID=123456789012345678

# Time for daily roundup in UTC (24h format)
ROUNDUP_TIME=08:00

# ── Shooting Stars ─────────────────────────────────────────────────────────────
# JWT Bearer token from the Star Miners community (join discord.gg/starminers)
# Without this, /stars will show a fallback link to map.starminers.site
STAR_MINERS_TOKEN=

# Override the Star Miners API base URL (default is fine for most users)
STAR_MINERS_URL=https://api.starminers.site

# Channel ID for auto-posting newly landed stars (requires STAR_MINERS_TOKEN)
STARS_CHANNEL_ID=123456789012345678
