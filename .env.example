# Discord bot token (required)
DISCORD_TOKEN=your_discord_bot_token_here

# Wise Old Man API key (optional, increases rate limit from 20 to 100 req/min)
WOM_API_KEY=

# Channel ID where the daily roundup will be posted
ROUNDUP_CHANNEL_ID=123456789012345678

# Time for daily roundup in UTC (24h format, e.g. 08:00)
ROUNDUP_TIME=08:00
